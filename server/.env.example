# Copy to .env (gitignored) and fill in. Never commit real values.
# Change streams (GET /events) need a replica set: Atlas or `mongod --replSet rs0`.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DB=stepsafe
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Without GEMINI_API_KEY, hazards are named by a local Ollama vision model when it answers at startup
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.8:27b-mlx
# Inline naming timeout; default 4000 for Gemini, 12000 for Ollama; capped at 15000 (the phone waits 20 s)
NAMER_TIMEOUT_MS=
# GET /tts; without a key it answers 503 and the phone uses its built-in voice
ELEVENLABS_API_KEY=
# premade "Sarah - Mature, Reassuring, Confident"
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_multilingual_v2
# Characters sent to ElevenLabs per UTC day (cache misses only); over it /tts answers 429 tts_budget
TTS_DAILY_CHAR_BUDGET=20000
# Same, per client IP
TTS_IP_DAILY_CHAR_BUDGET=2000
PORT=8787
# 127.0.0.1 behind cloudflared on the same box; 0.0.0.0 only for LAN testing
HOST=127.0.0.1
